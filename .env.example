# Salin menjadi .env sebelum `docker compose up`
POSTGRES_PASSWORD=ganti-dengan-sandi-kuat
ORIGIN=http://localhost:3000
PORT=3000
# Setel false di produksi agar akun contoh tidak tampil di halaman masuk
TAMPILKAN_AKUN_CONTOH=true

# Notifikasi surel dan WhatsApp (opsional). Kosongkan = hanya notifikasi di dalam aplikasi.
# Isi hanya pada penyebaran dengan data pengguna sungguhan (akun contoh memakai surel/nomor fiktif).
RESEND_API_KEY=
EMAIL_DARI=TANGGAP <notifikasi@domain-anda.id>
FONNTE_TOKEN=
